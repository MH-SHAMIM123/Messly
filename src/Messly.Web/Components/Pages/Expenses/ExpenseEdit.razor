@page "/expenses/add"
@page "/expenses/edit/{Id:guid}"
@rendermode InteractiveServer
@inject IExpenseService ExpenseService
@inject IMemberService MemberService
@inject FlatContextService FlatContext
@inject NavigationManager Navigation

<PageHeader Title="@_title" Subtitle="Record a mess expense" />
<AlertMessage Message="@_error" />

@if (_loading)
{
    <p>Loading...</p>
}
else if (_notFound)
{
    <p>Expense not found.</p>
    <a class="btn" href="/expenses">Back to list</a>
}
else if (_categories.Count == 0)
{
    <p>No expense categories available. Add a flat or refresh settings.</p>
}
else if (_members.Count == 0)
{
    <p>Add at least one active member before recording expenses.</p>
    <a class="btn" href="/members">Go to Members</a>
}
else
{
    <div class="card">
        <EditForm Model="_model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="form-grid">
                <div class="form-field">
                    <label>Title</label>
                    <InputText @bind-Value="_model.Title" />
                    <ValidationMessage For="() => _model.Title" />
                </div>
                <div class="form-field">
                    <label>Amount</label>
                    <InputNumber @bind-Value="_model.Amount" />
                    <ValidationMessage For="() => _model.Amount" />
                </div>
                <div class="form-field">
                    <label>Date</label>
                    <InputDate @bind-Value="_date" />
                    <ValidationMessage For="() => _model.ExpenseDate" />
                </div>
                <div class="form-field">
                    <label>Category</label>
                    <InputSelect @bind-Value="_model.ExpenseCategoryId">
                        <option value="">Select category</option>
                        @foreach (var c in _categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _model.ExpenseCategoryId" />
                </div>
                <div class="form-field">
                    <label>Paid By</label>
                    <InputSelect @bind-Value="_model.PaidByUserId">
                        <option value="">Select member</option>
                        @foreach (var m in _members)
                        {
                            <option value="@m.UserId">@m.FullName</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _model.PaidByUserId" />
                </div>
                <div class="form-field">
                    <label>Expense Type</label>
                    <InputSelect @bind-Value="_model.ExpenseType">
                        @foreach (ExpenseType t in Enum.GetValues<ExpenseType>())
                        {
                            <option value="@t">@t</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-field" style="grid-column:1/-1">
                    <label>Description (optional)</label>
                    <InputTextArea @bind-Value="_model.Description" rows="3" />
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@_saving">
                    @(_isEdit ? "Update Expense" : "Add Expense")
                </button>
                <a class="btn" href="/expenses">Cancel</a>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private ExpenseFormModel _model = new();
    private DateTime _date = DateTime.Today;
    private List<ExpenseCategoryDto> _categories = [];
    private List<MemberDto> _members = [];
    private bool _loading = true;
    private bool _saving;
    private bool _notFound;
    private bool _isEdit => Id.HasValue;
    private string? _error;
    private string _title => _isEdit ? "Edit Expense" : "Add Expense";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (!_loading)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _notFound = false;
        _error = null;
        _model = new ExpenseFormModel { FlatId = FlatContext.CurrentFlatId };

        _categories = (await ExpenseService.GetCategoriesAsync(FlatContext.CurrentFlatId)).ToList();
        _members = (await MemberService.GetMembersAsync(FlatContext.CurrentFlatId))
            .Where(m => m.IsActive)
            .ToList();

        if (Id.HasValue)
        {
            var expense = await ExpenseService.GetExpenseAsync(Id.Value);
            if (expense is null)
            {
                _notFound = true;
            }
            else
            {
                _model = new ExpenseFormModel
                {
                    Id = expense.Id,
                    FlatId = expense.FlatId,
                    Title = expense.Title,
                    Description = expense.Description,
                    Amount = expense.Amount,
                    ExpenseDate = expense.ExpenseDate,
                    ExpenseType = expense.ExpenseType,
                    PaidByUserId = expense.PaidByUserId,
                    ExpenseCategoryId = expense.ExpenseCategoryId
                };
                _date = expense.ExpenseDate.ToDateTime(TimeOnly.MinValue);
            }
        }
        else
        {
            _model.ExpenseDate = DateOnly.FromDateTime(_date);
            if (_members.Count > 0)
                _model.PaidByUserId = _members[0].UserId;
            if (_categories.Count > 0)
                _model.ExpenseCategoryId = _categories[0].Id;
        }

        _loading = false;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            _model.ExpenseDate = DateOnly.FromDateTime(_date);
            var dto = new ExpenseUpsertDto
            {
                Id = _model.Id,
                FlatId = _model.FlatId,
                Title = _model.Title.Trim(),
                Description = string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description.Trim(),
                Amount = _model.Amount,
                ExpenseDate = _model.ExpenseDate,
                ExpenseType = _model.ExpenseType,
                PaidByUserId = _model.PaidByUserId,
                ExpenseCategoryId = _model.ExpenseCategoryId
            };

            if (_isEdit)
                await ExpenseService.UpdateExpenseAsync(dto);
            else
                await ExpenseService.CreateExpenseAsync(dto);

            Navigation.NavigateTo("/expenses");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class ExpenseFormModel
    {
        public Guid? Id { get; set; }
        public Guid FlatId { get; set; }
        [Required] public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        [Range(0.01, double.MaxValue, ErrorMessage = "Amount must be greater than zero.")]
        public decimal Amount { get; set; }
        public DateOnly ExpenseDate { get; set; }
        public ExpenseType ExpenseType { get; set; } = ExpenseType.Grocery;
        [Required(ErrorMessage = "Paid by is required.")]
        public Guid PaidByUserId { get; set; }
        [Required(ErrorMessage = "Category is required.")]
        public Guid ExpenseCategoryId { get; set; }
    }
}
