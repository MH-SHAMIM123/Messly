@page "/expenses"
@rendermode InteractiveServer
@inject IExpenseService ExpenseService
@inject IJSRuntime Js

<PageHeader Title="Expenses" Subtitle="View and manage all flat expenses" ActionText="Add Expense" ActionUrl="/expenses/add" />
<AlertMessage Message="@_error" />
@if (!string.IsNullOrEmpty(_success)) { <div class="alert alert-success">@_success</div> }

<DataTable ColumnCount="5" IsLoading="@_loading" IsEmpty="@(_items.Count == 0)" EmptyMessage="No expenses recorded yet.">
    <HeadContent>
        <th>Date</th>
        <th>Amount</th>
        <th>Category</th>
        <th>Paid By</th>
        <th>Actions</th>
    </HeadContent>
    <BodyContent>
        @foreach (var item in _items)
        {
            <tr>
                <td>@item.ExpenseDate.ToString("dd MMM yyyy")</td>
                <td>@item.Amount.ToString("N2")</td>
                <td>@item.CategoryName</td>
                <td>@item.PaidByName</td>
                <td>
                    <a class="btn" href="/expenses/edit/@item.Id" title="@item.Title">Edit</a>
                    <button type="button" class="btn" @onclick="() => DeleteAsync(item)">Delete</button>
                </td>
            </tr>
        }
    </BodyContent>
</DataTable>

@code {
    private List<ExpenseDto> _items = [];
    private bool _loading = true;
    private string? _error;
    private string? _success;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _items = (await ExpenseService.GetExpensesAsync()).ToList();
        }
        catch (Exception ex)
        {
            _error = SafeErrorMessages.FromException(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteAsync(ExpenseDto item)
    {
        var confirmed = await Js.InvokeAsync<bool>("confirm", $"Delete expense '{item.Title}' ({item.Amount:N2})?");
        if (!confirmed) return;

        _success = null;
        try
        {
            await ExpenseService.DeleteExpenseAsync(item.Id);
            _success = "Expense deleted.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = SafeErrorMessages.FromException(ex);
        }
    }
}


