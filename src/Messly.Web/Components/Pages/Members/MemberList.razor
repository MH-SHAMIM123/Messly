@page "/members"
@rendermode InteractiveServer
@inject IMemberService MemberService
@inject FlatContextService FlatContext
@inject IJSRuntime Js

<PageHeader Title="Members" Subtitle="Manage all mess members" ActionText="Add Member" ActionUrl="/members/add" />

<AlertMessage Message="@_error" />
@if (!string.IsNullOrEmpty(_success)) { <div class="alert alert-success">@_success</div> }

<DataTable ColumnCount="4" IsLoading="@_loading" IsEmpty="@(_members.Count == 0)" EmptyMessage="No members found. Add your first member to get started.">
    <HeadContent>
        <th>Name</th>
        <th>Email</th>
        <th>Role</th>
        <th>Actions</th>
    </HeadContent>
    <BodyContent>
        @foreach (var member in _members)
        {
            <tr>
                <td>@member.FullName</td>
                <td>@member.Email</td>
                <td>@member.RoleName</td>
                <td>
                    <a class="btn" href="/members/edit/@member.Id">Edit</a>
                    <button type="button" class="btn" @onclick="() => DeleteMemberAsync(member)">Delete</button>
                </td>
            </tr>
        }
    </BodyContent>
</DataTable>

@code {
    private List<MemberDto> _members = [];
    private bool _loading = true;
    private string? _error;
    private string? _success;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _members = (await MemberService.GetMembersAsync(FlatContext.CurrentFlatId)).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteMemberAsync(MemberDto member)
    {
        var confirmed = await Js.InvokeAsync<bool>("confirm", $"Remove {member.FullName} from this flat?");
        if (!confirmed) return;

        _success = null;
        try
        {
            await MemberService.DeleteMemberAsync(member.Id);
            _success = $"{member.FullName} was removed.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
