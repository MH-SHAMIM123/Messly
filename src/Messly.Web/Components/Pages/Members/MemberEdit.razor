@page "/members/add"
@page "/members/edit/{Id:guid}"
@rendermode InteractiveServer
@inject IMemberService MemberService
@inject NavigationManager Navigation

<PageHeader Title="@_title" Subtitle="Add or update member details" />

<AlertMessage Message="@_error" />

@if (_loading)
{
    <p>Loading...</p>
}
else if (_notFound)
{
    <p>Member not found.</p>
    <a class="btn" href="/members">Back to list</a>
}
else
{
    <div class="card">
        <EditForm Model="_model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="form-grid">
                <div class="form-field">
                    <label>Full Name</label>
                    <InputText @bind-Value="_model.FullName" />
                    <ValidationMessage For="() => _model.FullName" />
                </div>
                <div class="form-field">
                    <label>Email</label>
                    <InputText @bind-Value="_model.Email" />
                    <ValidationMessage For="() => _model.Email" />
                </div>
                <div class="form-field">
                    <label>Phone</label>
                    <InputText @bind-Value="_model.Phone" />
                    <ValidationMessage For="() => _model.Phone" />
                </div>
                <div class="form-field">
                    <label>Role</label>
                    <InputSelect @bind-Value="_model.RoleType">
                        <option value="@RoleType.Member">Member</option>
                        <option value="@RoleType.Manager">Manager</option>
                    </InputSelect>
                    <ValidationMessage For="() => _model.RoleType" />
                </div>
                <div class="form-field">
                    <label>
                        <InputCheckbox @bind-Value="_model.IsActive" />
                        Active member
                    </label>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@_saving">
                    @(_isEdit ? "Update Member" : "Add Member")
                </button>
                <a class="btn" href="/members">Cancel</a>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private MemberFormModel _model = new();
    private bool _loading = true;
    private bool _saving;
    private bool _notFound;
    private bool _isEdit => Id.HasValue;
    private string? _error;
    private string _title => _isEdit ? "Edit Member" : "Add Member";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (!_loading)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _notFound = false;
        _error = null;
        _model = new MemberFormModel();

        if (Id.HasValue)
        {
            var member = await MemberService.GetMemberAsync(Id.Value);
            if (member is null)
            {
                _notFound = true;
            }
            else
            {
                _model = new MemberFormModel
                {
                    Id = member.Id,
                    FlatId = member.FlatId,
                    FullName = member.FullName,
                    Email = member.Email,
                    Phone = member.Phone,
                    RoleType = member.RoleType,
                    IsActive = member.IsActive
                };
            }
        }

        _loading = false;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            var dto = new MemberUpsertDto
            {
                Id = _model.Id,
                FullName = _model.FullName.Trim(),
                Email = _model.Email.Trim(),
                Phone = string.IsNullOrWhiteSpace(_model.Phone) ? null : _model.Phone.Trim(),
                RoleType = _model.RoleType,
                IsActive = _model.IsActive
            };

            if (_isEdit)
                await MemberService.UpdateMemberAsync(dto);
            else
                await MemberService.CreateMemberAsync(dto);

            Navigation.NavigateTo("/members");
        }
        catch (Exception ex)
        {
            _error = SafeErrorMessages.FromException(ex);
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class MemberFormModel
    {
        public Guid? Id { get; set; }
        public Guid FlatId { get; set; }
        [Required][StringLength(200)] public string FullName { get; set; } = string.Empty;
        [Required][EmailAddress] public string Email { get; set; } = string.Empty;
        [StringLength(20)] public string? Phone { get; set; }
        public RoleType RoleType { get; set; } = RoleType.Member;
        public bool IsActive { get; set; } = true;
    }
}


