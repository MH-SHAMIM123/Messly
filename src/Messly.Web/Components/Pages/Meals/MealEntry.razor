@page "/meals/entry"
@rendermode InteractiveServer
@inject IMealService MealService
@inject FlatContextService FlatContext

<PageHeader Title="Daily Meal Entry" Subtitle="Record breakfast, lunch, and dinner per member" />
<AlertMessage Message="@_error" />
@if (!string.IsNullOrEmpty(_success))
{
    <p class="text-success">@_success</p>
}

<div class="tabs">
    <a class="active" href="/meals/entry">Daily Entry</a>
    <a href="/meals/summary">Monthly Summary</a>
</div>

<div class="card" style="margin-bottom:1rem">
    <div class="form-field">
        <label>Date</label>
        <InputDate @bind-Value="_date" @bind-Value:after="OnDateChanged" />
    </div>
</div>

<DataTable ColumnCount="5" IsLoading="@_loading" IsEmpty="@(_entries.Count == 0)" EmptyMessage="No active members. Add members before recording meals.">
    <HeadContent>
        <th>Member</th><th>Breakfast</th><th>Lunch</th><th>Dinner</th><th>Total</th>
    </HeadContent>
    <BodyContent>
        @foreach (var entry in _entries)
        {
            <tr @key="entry.UserId">
                <td>@entry.MemberName</td>
                <td><input type="number" min="0" max="3" @bind="entry.BreakfastCount" @bind:event="oninput" /></td>
                <td><input type="number" min="0" max="3" @bind="entry.LunchCount" @bind:event="oninput" /></td>
                <td><input type="number" min="0" max="3" @bind="entry.DinnerCount" @bind:event="oninput" /></td>
                <td>@(entry.BreakfastCount + entry.LunchCount + entry.DinnerCount)</td>
            </tr>
        }
    </BodyContent>
</DataTable>

<div class="form-actions">
    <button type="button" class="btn btn-primary" disabled="@(_saving || _entries.Count == 0)" @onclick="SaveAsync">Save Daily Meals</button>
</div>

@code {
    private List<MealEntryDto> _entries = [];
    private DateTime _date = DateTime.Today;
    private bool _loading = true, _saving;
    private string? _error, _success;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnDateChanged() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _success = null;
        try
        {
            var date = DateOnly.FromDateTime(_date);
            _entries = (await MealService.GetMealEntriesByDateAsync(FlatContext.CurrentFlatId, date)).ToList();
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _success = null;
        try
        {
            await MealService.SaveDailyEntriesAsync(FlatContext.CurrentFlatId, DateOnly.FromDateTime(_date), _entries);
            _error = null;
            _success = "Meals saved successfully.";
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }
}
