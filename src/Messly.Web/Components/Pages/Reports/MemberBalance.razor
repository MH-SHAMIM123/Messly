@page "/reports/balances"
@rendermode InteractiveServer
@inject IBillingCalculationService BillingService
@inject FlatContextService FlatContext

<PageHeader Title="Member Balances" Subtitle="Meal cost, deposits, and balance per member" />
<AlertMessage Message="@_error" />

<div class="tabs">
    <a href="/reports/monthly">Monthly Summary</a>
    <a class="active" href="/reports/balances">Member Balances</a>
</div>

<div class="card" style="margin-bottom:1rem">
    <div class="form-field">
        <label>Month</label>
        <input type="month" value="@_monthValue" @onchange="OnMonthChanged" />
    </div>
</div>

@if (!string.IsNullOrEmpty(_calculationNote))
{
    <p class="text-muted">@_calculationNote</p>
}

<DataTable ColumnCount="5" IsLoading="@_loading" IsEmpty="@(_rows.Count == 0)" EmptyMessage="No active members for this flat.">
    <HeadContent>
        <th>Member</th><th>Total Meal</th><th>Deposit</th><th>Cost</th><th>Balance</th>
    </HeadContent>
    <BodyContent>
        @foreach (var row in _rows)
        {
            <tr @key="row.UserId">
                <td>@row.MemberName</td>
                <td>@row.TotalMeals</td>
                <td>@row.TotalDeposits.ToString("N2")</td>
                <td>@row.MealCost.ToString("N2")</td>
                <td class="@(row.Balance < 0 ? "text-negative" : "")">@row.Balance.ToString("N2")</td>
            </tr>
        }
    </BodyContent>
</DataTable>

@code {
    private List<MemberBalanceDto> _rows = [];
    private string _monthValue = DateTime.Today.ToString("yyyy-MM");
    private bool _loading = true;
    private string? _error, _calculationNote;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        _monthValue = e.Value?.ToString() ?? _monthValue;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _calculationNote = null;
        try
        {
            if (!DateOnly.TryParse(_monthValue + "-01", out var first))
                return;

            var summary = await BillingService.BuildFinancialSummaryAsync(
                FlatContext.CurrentFlatId,
                first.Year,
                first.Month);
            _calculationNote = summary.CalculationNote;
            _rows = summary.MemberBalances.ToList();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}
